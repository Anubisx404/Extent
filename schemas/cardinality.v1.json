{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extent cardinality --json",
  "description": "Metric label cardinality safety analysis.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "extent.cardinality/v1"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "findings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "suggestions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "unparsed": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "score"
  ]
}
