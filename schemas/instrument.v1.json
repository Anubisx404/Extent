{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extent instrument --json",
  "description": "Instrumentation preview or applied result.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "extent.instrument/v1"
    },
    "changedFiles": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "messages": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "diff": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "changedFiles",
    "messages"
  ]
}
